{
  "name": "vettedcfb",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/inbox"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "vettedcfb", "database_id": "ca2ab27e-3537-4bb4-9d2c-870789e983db" }
  ],
  // INBOX_KEY is a secret set in the Cloudflare dashboard (Settings → Variables and Secrets). Never put it in this file.
  "keep_vars": true
}
